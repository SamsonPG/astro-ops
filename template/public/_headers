# Response headers. Cloudflare Pages/Workers and Netlify both read this file.
#
# These are the ones worth setting on a static content site. Deliberately NOT a maximal
# list — a header you do not understand is a header you will disable the first time it
# breaks something, and a security policy nobody trusts is worse than none.

/*
  # Stops a browser second-guessing your Content-Type. Without it, a file you serve as
  # text/plain can be sniffed as HTML and executed — the cheapest XSS vector there is.
  X-Content-Type-Options: nosniff

  # Send the full URL to your own pages, only the origin to other sites, and nothing at
  # all when downgrading to http. Keeps paths (which often carry identifiers) off other
  # people's servers without breaking your own analytics.
  Referrer-Policy: strict-origin-when-cross-origin

  # Explicitly refuse hardware you do not use. This is not hypothetical protection: it
  # also refuses on behalf of any third-party frame you embed later and forget about.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

  # This site loads nothing from anywhere else, so the policy can say exactly that —
  # and `astro-ops check:external` fails the build if that ever stops being true, which
  # is what keeps this line honest rather than aspirational.
  #
  # 'unsafe-inline' for style-src is required by Astro's scoped styles. script-src has
  # no such escape hatch here, which is the half that actually matters.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: DENY

# Content-hashed filenames can be cached forever — the name changes when the bytes do.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  # Assets are not pages. Keeping them out of the index stops a stylesheet ranking for
  # your brand name, which happens more often than you would think.
  X-Robots-Tag: noindex, nofollow
