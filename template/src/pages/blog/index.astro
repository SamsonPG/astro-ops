---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

/**
 * Drafts are excluded HERE and from the sitemap and RSS, from the same predicate.
 * Three separate "is this published?" rules is how a draft ends up in a feed.
 */
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base
  title="Blog"
  description="Notes on the operational work that keeps a site correct once it is no longer being watched."
>
  <h1>Blog</h1>
  <p class="meta">{posts.length} post{posts.length === 1 ? '' : 's'}</p>

  <ul class="posts">
    {posts.map((post) => (
      <li class="card">
        <h2 style="margin:0 0 .35rem;font-size:1.15rem">
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        </h2>
        <p class="meta">
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          {post.data.tags.map((t) => <span class="tag">{t}</span>)}
        </p>
        <p style="margin:.4rem 0 0">{post.data.description}</p>
      </li>
    ))}
  </ul>
</Base>
